---
import { sections } from "../content.config";
import { docPath, type Doc } from "../lib/docs";

interface Props {
  docs: Doc[];
  currentId: string;
  label?: string;
}

const { docs, currentId, label = "Documentation" } = Astro.props;
const current = docs.find(doc => doc.id === currentId);
const groups = sections.map(name => ({
  name,
  docs: docs.filter(doc => doc.data.section === name && !doc.data.parent)
}));
---

<nav class="docs-nav" aria-label={label}>
  {groups.map(group => (
    <section>
      <h2>{group.name}</h2>
      <ul>
        {group.docs.map(doc => (
          <li>
            <a
              href={docPath(doc)}
              aria-current={doc.id === currentId ? "page" : undefined}
            >
              {doc.data.title}
            </a>
            {(currentId === doc.id || current?.data.parent === doc.id) &&
              docs.some(child => child.data.parent === doc.id) && (
                <ul class="docs-subnav">
                  {docs
                    .filter(child => child.data.parent === doc.id)
                    .map(child => (
                      <li>
                        <a
                          href={docPath(child)}
                          aria-current={
                            child.id === currentId ? "page" : undefined
                          }
                        >
                          {child.data.title}
                        </a>
                      </li>
                    ))}
                </ul>
              )}
          </li>
        ))}
      </ul>
    </section>
  ))}
</nav>
