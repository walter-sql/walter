---
import Logo from "./Logo.astro";
import Search from "./Search.astro";
const inDocs = Astro.url.pathname.startsWith("/docs");
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href="/" aria-label="Walter home">
      <Logo />
      <span>walter</span>
    </a>
    <span class="header-divider" aria-hidden="true"></span>
    <nav class="primary-nav" aria-label="Main">
      <a href="/docs/" aria-current={inDocs ? "true" : undefined}>
        Documentation
      </a>
      <a class="engine-link" href="/docs/how-it-works/">
        The engine
      </a>
    </nav>
    <div class="header-tools">
      <Search />
      <a
        class="github-link"
        href="https://github.com/walter-sql/walter"
        aria-label="Walter on GitHub"
      >
        <svg
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03A9.6 9.6 0 0 1 12 6.82c.85 0 1.71.11 2.51.34 1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />
        </svg>
      </a>
      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        aria-label="Switch to light theme"
      >
        <svg
          class="sun"
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
        </svg>
        <svg
          class="moon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="M20.3 14A8.5 8.5 0 0 1 10 3.7 8.5 8.5 0 1 0 20.3 14Z" />
        </svg>
      </button>
    </div>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>("#theme-toggle")!;
  const updateThemeControls = () => {
    toggle.setAttribute(
      "aria-label",
      `Switch to ${document.documentElement.dataset.theme === "dark" ? "light" : "dark"} theme`
    );
    document.querySelector<HTMLMetaElement>(
      'meta[name="theme-color"]'
    )!.content = getComputedStyle(document.documentElement)
      .getPropertyValue("--bg")
      .trim();
  };
  updateThemeControls();
  toggle.addEventListener("click", () => {
    const theme =
      document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = theme;
    try {
      localStorage.setItem("theme", theme);
    } catch {}
    updateThemeControls();
  });
  matchMedia("(prefers-color-scheme: dark)").addEventListener(
    "change",
    event => {
      let saved: string | null = null;
      try {
        saved = localStorage.getItem("theme");
      } catch {}
      if (!saved)
        document.documentElement.dataset.theme = event.matches
          ? "dark"
          : "light";
      updateThemeControls();
    }
  );
</script>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    backdrop-filter: blur(16px);
  }
  .header-inner {
    display: flex;
    align-items: center;
    height: var(--header-height);
    gap: 30px;
  }
  .wordmark {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 29px;
    letter-spacing: -0.055em;
    font-weight: 650;
    color: var(--ink);
    text-decoration: none;
    line-height: 1;
  }
  .header-divider {
    width: 1px;
    height: 22px;
    background: var(--hairline-strong);
  }
  .primary-nav {
    display: flex;
    align-items: center;
    gap: 26px;
    height: 100%;
  }
  .primary-nav a {
    display: flex;
    align-items: center;
    height: 100%;
    position: relative;
    color: var(--muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
  }
  .primary-nav a:hover,
  .primary-nav a[aria-current] {
    color: var(--ink);
  }
  .primary-nav a[aria-current]::after {
    content: "";
    position: absolute;
    bottom: -1px;
    height: 2px;
    left: 0;
    right: 0;
    background: var(--ink);
  }
  .header-tools {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-left: auto;
  }
  .github-link,
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 32px;
    height: 36px;
    color: var(--muted);
    background: none;
    border: 0;
    border-radius: 4px;
  }
  .github-link:hover,
  .theme-toggle:hover {
    background: var(--surface);
    color: var(--ink);
  }
  .sun {
    display: none;
  }
  :global([data-theme="dark"]) .sun {
    display: block;
  }
  :global([data-theme="dark"]) .moon {
    display: none;
  }
  @media (max-width: 1050px) {
    .engine-link {
      display: none !important;
    }
    .header-inner {
      gap: 24px;
    }
  }
  @media (max-width: 620px) {
    .header-inner {
      gap: 18px;
    }
    .header-divider,
    .github-link {
      display: none;
    }
    .wordmark {
      font-size: 26px;
      gap: 7px;
    }
    .wordmark :global(svg) {
      width: 25px;
    }
    .primary-nav a {
      font-size: 13px;
    }
    .header-tools {
      gap: 5px;
    }
  }
  @media (max-width: 380px) {
    .header-inner {
      padding-inline: 16px;
      gap: 12px;
    }
  }
</style>
