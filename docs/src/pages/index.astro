---
import Base from "../layouts/Base.astro";
import SyncScene from "../components/SyncScene.astro";
import LiveQuery from "../components/LiveQuery.astro";
import Logo from "../components/Logo.astro";
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Walter",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux, macOS, Windows",
  description:
    "Live SQL query results for Postgres. Subscribe from your server and receive updates as the result changes.",
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  url: Astro.site?.href,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" }
});
const arrow = "M4 8h16m-6-6 6 6-6 6";
---

<Base
  title="Walter - Live queries for Postgres"
  description="Subscribe to SQL query results from your Postgres database. Walter keeps them up to date and sends changes through your application server."
>
  <script
    is:inline
    type="application/ld+json"
    set:html={jsonLd}
    slot="head"
  ></script>
  <main id="main-content" tabindex="-1">
    <section class="shell hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">
          Live queries.
          <br />
          <span>For Postgres.</span>
        </h1>
        <p class="hero-description">
          Subscribe to a SQL query and receive updates as the data changes,
          using the Postgres database behind your app.
        </p>
        <div class="hero-actions">
          <a class="btn" href="/docs/installation/">
            Get started
            <svg
              width="21"
              height="16"
              viewBox="0 0 24 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              aria-hidden="true"
            >
              <path d={arrow} />
            </svg>
          </a>
          <a class="arrow-link" href="/docs/">
            Read the docs
          </a>
        </div>
        <div class="hero-note">
          <span>Open source</span>
          <span aria-hidden="true">/</span>
          <span>Apache 2.0</span>
          <span aria-hidden="true">/</span>
          <span>SQL subscriptions</span>
        </div>
      </div>
      <div class="hero-visual">
        <SyncScene />
      </div>
    </section>
    <div class="shell">
      <div class="foundation-strip" aria-label="Engine fundamentals">
        <div>
          <span class="strip-index">01</span>
          <span>
            SQL queries
            <span class="strip-detail">Joins and nested results.</span>
          </span>
        </div>
        <div>
          <span class="strip-index">02</span>
          <span>
            Your Postgres
            <span class="strip-detail">Uses logical replication.</span>
          </span>
        </div>
        <div>
          <span class="strip-index">03</span>
          <span>
            Incremental updates
            <span class="strip-detail">Changes to query results.</span>
          </span>
        </div>
        <div>
          <span class="strip-index">04</span>
          <span>
            In-memory state
            <span class="strip-detail">Rebuilt after a restart.</span>
          </span>
        </div>
      </div>
    </div>
    <section class="shell query-section" aria-labelledby="query-title">
      <div class="section-heading">
        <div>
          <p class="kicker">01 / A live query</p>
          <h2 id="query-title">See a query update.</h2>
        </div>
        <p>
          Choose the rows your app needs. Walter follows changes to that result.
        </p>
      </div>
      <LiveQuery />
    </section>
    <section class="architecture-section" aria-labelledby="architecture-title">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="kicker">02 / Your application</p>
            <h2 id="architecture-title">From Postgres to your app.</h2>
          </div>
          <p>
            Your server checks access and subscribes to queries. Walter sends
            the results as they change. Writes use your existing API.
          </p>
        </div>
        <div
          class="architecture"
          role="img"
          aria-label="Postgres sends changes through logical replication to Walter. Walter sends snapshots and diffs to your server, which forwards them to your app. Writes go through your application."
        >
          <div class="architecture-flow">
            <div class="system-node">
              <svg
                width="28"
                height="28"
                viewBox="0 0 32 32"
                fill="none"
                stroke="currentColor"
                stroke-width="1.2"
                aria-hidden="true"
              >
                <ellipse cx="16" cy="7" rx="10" ry="4" />
                <path d="M6 7v18c0 2.2 4.5 4 10 4s10-1.8 10-4V7M6 16c0 2.2 4.5 4 10 4s10-1.8 10-4" />
              </svg>
              <span>Postgres</span>
              <small>Source of truth</small>
            </div>
            <div class="flow-line">
              <span>logical replication</span>
              <i aria-hidden="true"></i>
            </div>
            <div class="system-node walter-node">
              <Logo size={30} />
              <span>Walter</span>
              <small>Maintains query results</small>
            </div>
            <div class="flow-line">
              <span>snapshot + diffs</span>
              <i aria-hidden="true"></i>
            </div>
            <div class="system-node">
              <svg
                width="28"
                height="28"
                viewBox="0 0 32 32"
                fill="none"
                stroke="currentColor"
                stroke-width="1.2"
                aria-hidden="true"
              >
                <rect x="5" y="4" width="22" height="10" rx="2" />
                <rect x="5" y="18" width="22" height="10" rx="2" />
                <path d="M9 9h2m-2 14h2m9-14h3m-3 14h3" />
              </svg>
              <span>Your server</span>
              <small>Access and subscriptions</small>
            </div>
            <div class="flow-line">
              <span>your API transport</span>
              <i aria-hidden="true"></i>
            </div>
            <div class="system-node">
              <svg
                width="28"
                height="28"
                viewBox="0 0 32 32"
                fill="none"
                stroke="currentColor"
                stroke-width="1.2"
                aria-hidden="true"
              >
                <rect x="3" y="5" width="26" height="22" rx="2" />
                <path d="M3 11h26M7 8h1m2 0h1m2 0h1" />
              </svg>
              <span>Your app</span>
              <small>Any framework</small>
            </div>
          </div>
          <div class="write-path">
            <span>Writes go through your application.</span>
          </div>
        </div>
        <div class="architecture-foot">
          <span>No extensions or triggers required.</span>
          <a class="arrow-link" href="/docs/your-app/">
            Connect your application
          </a>
        </div>
      </div>
    </section>
    <section class="shell principles" aria-labelledby="principles-title">
      <div class="principles-intro">
        <p class="kicker">03 / In practice</p>
        <h2 id="principles-title">
          What to know
          <br />
          before you start.
        </h2>
        <a class="arrow-link" href="/docs/how-it-works/">
          How Walter works
        </a>
      </div>
      <div class="principle-list">
        <a href="/docs/sql-support/">
          <span class="principle-number">01</span>
          <div>
            <h3>Supported SQL</h3>
            <p>
              Walter supports SELECT queries with joins, nesting, and
              aggregates. Check the SQL reference for the constructs your
              application uses.
            </p>
          </div>
          <span class="principle-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
        <a href="/docs/performance/">
          <span class="principle-number">02</span>
          <div>
            <h3>Memory for active queries</h3>
            <p>
              Walter retains the source rows and results its queries need.
              Memory use depends on your queries and their data.
            </p>
          </div>
          <span class="principle-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
        <a href="/docs/operations/">
          <span class="principle-number">03</span>
          <div>
            <h3>Recovery through snapshots</h3>
            <p>
              After a restart, clients resubscribe and receive fresh results
              from Postgres. Your app can replace its previous rows.
            </p>
          </div>
          <span class="principle-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      </div>
    </section>
    <section class="shell docs-gateway" aria-labelledby="gateway-title">
      <div class="section-heading">
        <div>
          <p class="kicker">04 / Documentation</p>
          <h2 id="gateway-title">Start with your application.</h2>
        </div>
        <a class="arrow-link" href="/docs/">
          All documentation
        </a>
      </div>
      <div class="guide-grid">
        <a class="guide" href="/docs/installation/">
          <span class="guide-label">
            GET STARTED <span aria-hidden="true">↗</span>
          </span>
          <h3>Set up Walter</h3>
          <p>
            Prepare your Postgres database and start the engine with Docker or
            Node.js.
          </p>
          <span class="guide-meta">
            Installation <span>→</span>
          </span>
        </a>
        <a class="guide" href="/docs/your-app/">
          <span class="guide-label">
            INTEGRATE <span aria-hidden="true">↗</span>
          </span>
          <h3>Connect your server</h3>
          <p>
            Add authentication, streaming, and live results to your application.
          </p>
          <span class="guide-meta">
            Integration guide <span>→</span>
          </span>
        </a>
        <a class="guide" href="/docs/relations/">
          <span class="guide-label">
            GO DEEPER <span aria-hidden="true">↗</span>
          </span>
          <h3>Joins and nested results</h3>
          <p>
            Return related data as columns, objects, or arrays in one query.
          </p>
          <span class="guide-meta">
            Query guide <span>→</span>
          </span>
        </a>
      </div>
    </section>
    <section class="shell closing">
      <div>
        <p class="kicker">Get started</p>
        <h2>
          Try a query
          <br />
          from your app.
        </h2>
      </div>
      <div class="closing-action">
        <a class="btn" href="/docs/installation/">
          Install Walter
          <svg
            width="21"
            height="16"
            viewBox="0 0 24 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            aria-hidden="true"
          >
            <path d={arrow} />
          </svg>
        </a>
        <span>Postgres · Docker or Node.js</span>
      </div>
    </section>
  </main>
</Base>
<style>
  .hero {
    display: grid;
    grid-template-columns: 1.03fr 1fr;
    align-items: center;
    gap: 0;
    padding-block: 92px 74px;
  }
  .hero-copy {
    position: relative;
    z-index: 1;
  }
  .hero h1 {
    font-size: clamp(54px, 5.55vw, 80px);
    font-weight: 550;
    line-height: 1.035;
    letter-spacing: -0.055em;
    white-space: nowrap;
  }
  .hero h1 > span {
    color: var(--muted);
  }
  .hero-description {
    max-width: 430px;
    margin-top: 27px;
    color: var(--muted);
    font-size: 19px;
    line-height: 1.65;
    text-wrap: pretty;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 29px;
    margin-top: 32px;
  }
  .hero-actions :is(.btn, .arrow-link) {
    white-space: nowrap;
  }
  .hero-note {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-top: 25px;
    color: var(--faint);
    font-size: 11px;
  }
  .hero-note span[aria-hidden] {
    color: var(--hairline-strong);
  }
  .hero-visual {
    min-width: 0;
    margin: -40px -24px -30px -5px;
  }
  .foundation-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-block: 1px solid var(--hairline);
    padding-block: 27px;
  }
  .foundation-strip > div {
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding-inline: 25px;
    border-right: 1px solid var(--hairline);
    font-size: 15px;
  }
  .foundation-strip > div:first-child {
    padding-left: 0;
  }
  .foundation-strip > div:last-child {
    border-right: 0;
  }
  .strip-index {
    font: 10px var(--mono);
    color: var(--faint);
  }
  .strip-detail {
    display: block;
    margin-top: 3px;
    font-size: 12px;
    color: var(--faint);
  }
  .query-section {
    padding-block: 90px 86px;
  }
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 34px;
  }
  .section-heading h2 {
    font-size: 39px;
    font-weight: 550;
    margin-top: 15px;
    letter-spacing: -0.04em;
  }
  .section-heading > p {
    max-width: 380px;
    font-size: 16px;
    color: var(--muted);
    line-height: 1.6;
    padding-bottom: 3px;
  }
  .architecture-section {
    border-block: 1px solid var(--hairline);
    padding-block: 76px 42px;
    background: color-mix(in srgb, var(--surface) 40%, var(--bg));
  }
  .architecture {
    margin-top: 62px;
    padding: 10px 45px 0;
  }
  .architecture-flow {
    display: grid;
    grid-template-columns: 130px 1fr 130px 1fr 130px 1fr 130px;
    align-items: center;
  }
  .system-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    color: var(--muted);
  }
  .system-node > span {
    color: var(--ink);
    font-size: 16px;
    margin-top: 8px;
  }
  .system-node small {
    font-size: 11px;
    color: var(--faint);
    white-space: nowrap;
  }
  .walter-node > :global(svg) {
    color: var(--ink);
  }
  .flow-line {
    position: relative;
    margin: -28px 8px 0;
  }
  .flow-line span {
    display: block;
    font: 9px var(--mono);
    color: var(--faint);
    text-align: center;
    white-space: nowrap;
    margin-bottom: 15px;
  }
  .flow-line i {
    display: block;
    height: 1px;
    background: var(--hairline-strong);
    position: relative;
  }
  .flow-line i::after {
    content: "";
    position: absolute;
    right: 0;
    top: -3px;
    width: 6px;
    height: 6px;
    border-right: 1px solid var(--faint);
    border-top: 1px solid var(--faint);
    transform: rotate(45deg);
  }
  .write-path {
    position: relative;
    width: calc((100% - 130px) * 2 / 3);
    height: 38px;
    margin: 20px 0 0 65px;
    border: 1px solid var(--hairline-strong);
    border-top: 0;
    border-radius: 0 0 6px 6px;
  }
  .write-path::before {
    content: "";
    position: absolute;
    top: 0;
    left: -3px;
    width: 5px;
    height: 5px;
    border-top: 1px solid var(--faint);
    border-left: 1px solid var(--faint);
    transform: rotate(45deg);
  }
  .write-path span {
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    padding-inline: 14px;
    white-space: nowrap;
    background: color-mix(in srgb, var(--surface) 40%, var(--bg));
    color: var(--faint);
    font: 10px var(--mono);
  }
  .architecture-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-top: 64px;
    padding-top: 25px;
    border-top: 1px solid var(--hairline);
  }
  .architecture-foot > span {
    font-size: 13px;
    color: var(--faint);
  }
  .principles {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 80px;
    padding-block: 98px;
  }
  .principles-intro h2 {
    margin-top: 18px;
    font-size: 43px;
    font-weight: 550;
    line-height: 1.12;
  }
  .principles-intro .arrow-link {
    margin-top: 28px;
  }
  .principle-list a {
    display: flex;
    gap: 21px;
    padding-block: 29px;
    border-bottom: 1px solid var(--hairline);
    text-decoration: none;
  }
  .principle-list a:first-child {
    padding-top: 0;
  }
  .principle-list a:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .principle-number {
    color: var(--faint);
    font: 10px var(--mono);
    margin-top: 5px;
  }
  .principle-list h3 {
    color: var(--ink);
    font-size: 22px;
    font-weight: 550;
    letter-spacing: -0.02em;
  }
  .principle-list p {
    color: var(--muted);
    font-size: 15px;
    margin-top: 12px;
    max-width: 410px;
    line-height: 1.65;
  }
  .principle-arrow {
    margin-left: auto;
    color: var(--faint);
    transition: transform 180ms;
  }
  .principle-list a:hover .principle-arrow {
    transform: translate(2px, -2px);
    color: var(--ink);
  }
  .docs-gateway {
    padding-top: 66px;
    border-top: 1px solid var(--hairline);
  }
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--hairline);
    border-radius: 6px;
    overflow: hidden;
  }
  .guide {
    padding: 29px;
    text-decoration: none;
    color: var(--ink);
    display: flex;
    flex-direction: column;
  }
  .guide + .guide {
    border-left: 1px solid var(--hairline);
  }
  .guide:hover {
    background: var(--surface);
  }
  .guide-label {
    display: flex;
    justify-content: space-between;
    color: var(--faint);
    font: 10px var(--mono);
    letter-spacing: 0.06em;
  }
  .guide-label > span {
    font-size: 16px;
  }
  .guide h3 {
    font-size: 23px;
    font-weight: 550;
    letter-spacing: -0.02em;
    margin-top: 35px;
  }
  .guide p {
    font-size: 15px;
    color: var(--muted);
    margin-block: 13px 26px;
    max-width: 275px;
    line-height: 1.6;
  }
  .guide-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    color: var(--muted);
    font-size: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--hairline);
  }
  .closing {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
    padding-top: 110px;
  }
  .closing h2 {
    font-size: 58px;
    font-weight: 550;
    margin-top: 20px;
    line-height: 1.07;
    letter-spacing: -0.045em;
  }
  .closing-action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding-right: 64px;
  }
  .closing-action > span {
    color: var(--faint);
    font: 10px var(--mono);
  }
  @media (max-width: 1100px) {
    .hero {
      padding-block: 72px 64px;
    }
    .hero h1 {
      font-size: 64px;
    }
    .hero-note {
      gap: 8px;
      font-size: 10px;
    }
    .hero-description {
      max-width: 370px;
      font-size: 17px;
    }
    .architecture {
      padding-inline: 0;
    }
    .architecture-flow {
      grid-template-columns: 115px 1fr 115px 1fr 115px 1fr 115px;
    }
    .flow-line span {
      font-size: 8px;
    }
    .write-path {
      margin-left: 57px;
      width: calc((100% - 115px) * 2 / 3);
    }
    .principles {
      gap: 50px;
    }
    .foundation-strip > div {
      padding-inline: 17px;
      gap: 10px;
    }
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 68px;
      text-align: center;
    }
    .hero h1 {
      font-size: 76px;
    }
    .hero-eyebrow,
    .hero-actions,
    .hero-note {
      justify-content: center;
    }
    .hero-description {
      margin-inline: auto;
      max-width: 440px;
    }
    .hero-visual {
      max-width: 630px;
      width: 100%;
      margin: 12px auto -12px;
    }
    .foundation-strip {
      grid-template-columns: 1fr 1fr;
      padding-block: 0;
    }
    .foundation-strip > div {
      padding: 20px !important;
    }
    .foundation-strip > div:nth-child(2) {
      border-right: 0;
    }
    .foundation-strip > div:nth-child(-n + 2) {
      border-bottom: 1px solid var(--hairline);
    }
    .section-heading > p {
      max-width: 300px;
      font-size: 15px;
    }
    .architecture-flow {
      grid-template-columns: 100px 1fr 100px 1fr 100px 1fr 100px;
    }
    .flow-line span {
      white-space: normal;
      min-height: 24px;
      line-height: 1.5;
    }
    .system-node small {
      font-size: 9px;
    }
    .write-path {
      margin-left: 50px;
      width: calc((100% - 100px) * 2 / 3);
    }
    .principles {
      grid-template-columns: 1fr;
      gap: 42px;
    }
    .principle-list p {
      max-width: none;
    }
    .guide {
      padding: 23px;
    }
    .guide h3 {
      font-size: 21px;
    }
    .closing-action {
      padding-right: 0;
    }
  }
  @media (max-width: 620px) {
    .hero {
      padding-block: 55px 43px;
      text-align: left;
    }
    .hero h1 {
      font-size: clamp(44px, 11vw, 65px);
    }
    .hero-eyebrow,
    .hero-actions,
    .hero-note {
      justify-content: flex-start;
    }
    .hero-description {
      margin-top: 22px;
      margin-inline: 0;
      font-size: 17px;
      max-width: 370px;
    }
    .hero-eyebrow {
      margin-bottom: 23px;
      font-size: 9px;
    }
    .hero-actions {
      gap: 24px;
      margin-top: 28px;
    }
    .hero-actions .arrow-link {
      font-size: 14px;
      gap: 10px;
    }
    .hero-visual {
      margin: 30px -16px -12px;
      width: calc(100% + 32px);
    }
    .hero-note {
      margin-top: 21px;
      font-size: 10px;
      gap: 10px;
    }
    .foundation-strip > div {
      padding: 18px 12px !important;
      gap: 10px;
      font-size: 14px;
    }
    .strip-detail {
      font-size: 11px;
    }
    .strip-index {
