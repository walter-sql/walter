{
  "name": "@walter-sql/tanstack-query",
  "version": "0.0.0",
  "description": "Keep TanStack Query results up to date with Walter.",
  "license": "Apache-2.0",
  "homepage": "https://walter.ax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/walter-sql/walter.git",
    "directory": "packages/tanstack-query"
  },
  "bugs": "https://github.com/walter-sql/walter/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@walter-sql/view": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/query-core": ">=5"
  },
  "devDependencies": {
    "@tanstack/query-core": "^5.102.8",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
